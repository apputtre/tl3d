{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "type": "shell",
            "command": "C:/msys64/usr/bin/make",
            "options": {
                "cwd": "${workspaceFolder}/test"
            }
        },
        {
            "label": "run",
            "type": "shell",
            "command": "./run_tests.exe",
            "options": {
                "cwd": "${workspaceFolder}/test/bin"
            },
            "dependsOn": "make"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "C:/msys64/usr/bin/make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}/test"
            }
        }
    ]
}